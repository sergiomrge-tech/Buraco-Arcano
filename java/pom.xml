<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.buracoarcano</groupId><artifactId>buraco-arcano-web</artifactId><version>0.2.0</version>
  <properties><maven.compiler.release>17</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <dependencies>
    <dependency><groupId>org.teavm</groupId><artifactId>teavm-classlib</artifactId><version>0.16.0</version></dependency>
    <dependency><groupId>org.teavm</groupId><artifactId>teavm-jso</artifactId><version>0.16.0</version></dependency>
  </dependencies>
  <build><plugins>
    <plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.0</version>
      <configuration><release>17</release></configuration>
    </plugin>
    <plugin>
      <groupId>org.teavm</groupId><artifactId>teavm-maven-plugin</artifactId><version>0.16.0</version>
      <executions><execution><id>compile-for-browser</id><phase>process-classes</phase>
        <goals><goal>compile</goal></goals>
        <configuration>
          <mainClass>com.buracoarcano.BrowserBridge</mainClass>
          <targetDirectory>${project.basedir}/../web/java</targetDirectory>
          <targetFileName>engine.js</targetFileName>
          <targetType>JAVASCRIPT</targetType><jsModuleType>ES2015</jsModuleType>
          <minifying>true</minifying><sourceMapsGenerated>false</sourceMapsGenerated><mainPageIncluded>false</mainPageIncluded>
        </configuration>
      </execution></executions>
    </plugin>
  </plugins></build>
</project>
